rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isCompanyUser() {
      return isAuthenticated() &&
             request.auth.token.email.matches('.*@games24x7.com');
    }

    // For subcollections, we need to get the parent campaign document
    function isCollaboratorByIdForSubcollection(campaignId) {
      let campaign = get(/databases/$(database)/documents/campaigns/$(campaignId));
      return isCompanyUser() &&
             campaign != null &&
             campaign.data != null &&
             (request.auth.uid in campaign.data.collaboratorIds || 
              request.auth.uid == campaign.data.createdBy);
    }

    // --- Campaign Rules ---

    match /campaigns/{campaignId} {
      // Allow read if user is authenticated with company email
      allow read: if isCompanyUser();
      
      // Allow write if user is authenticated with company email and is a collaborator
      allow write: if isCollaboratorByIdForSubcollection(campaignId);

      // Allow access to proposal subcollection and its documents
      match /proposal/{proposalId} {
        // Allow read if user is a collaborator
        allow read: if isCollaboratorByIdForSubcollection(campaignId);
        
        // Allow write if user is a collaborator
        allow write: if isCollaboratorByIdForSubcollection(campaignId);
        
        // Allow access to template document within proposal subcollection
        match /template/{document=**} {
          // Allow read if user is a collaborator
          allow read: if isCollaboratorByIdForSubcollection(campaignId);
          
          // Allow write if user is a collaborator
          allow write: if isCollaboratorByIdForSubcollection(campaignId);
        }
      }
    }
  }
}