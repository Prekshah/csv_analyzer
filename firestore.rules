rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isCompanyUser() {
      return isAuthenticated() &&
             request.auth.token.email.matches('.*@games24x7.com');
    }

    // Fixed: Use resource.data to avoid circular dependency
    function isCollaboratorById(campaignId) {
      return isCompanyUser() &&
             request.auth.uid in resource.data.collaboratorIds;
    }

    // For subcollections, we need to get the parent campaign document
    function isCollaboratorByIdForSubcollection(campaignId) {
      let campaign = get(/databases/$(database)/documents/campaigns/$(campaignId));
      return isCompanyUser() &&
             campaign.exists() &&
             request.auth.uid in campaign.data.collaboratorIds;
    }

    function canEditCampaign(campaignId) {
      let userId = request.auth.uid;
      return isCompanyUser() &&
             userId in resource.data.collaboratorIds &&
             resource.data.collaborators[userId].role in ['owner', 'editor'];
    }

    function isOwner(campaignId) {
      let userId = request.auth.uid;
      return isCompanyUser() &&
             userId in resource.data.collaboratorIds &&
             resource.data.collaborators[userId].role == 'owner';
    }

    // --- Rules Per Collection ---

    // Campaign documents
    match /campaigns/{campaignId} {
      // 🔒 Fixed: Use collaboratorIds array to avoid circular dependency
      allow read: if isCompanyUser() && 
                  request.auth.uid in resource.data.collaboratorIds;

      // Allow listing/querying campaigns where user is a collaborator
      // This is critical for the array-contains query to work
      // TEMPORARILY VERY PERMISSIVE FOR DEBUGGING
      allow list: if true;

      allow update: if canEditCampaign(campaignId);

      allow create: if isCompanyUser() &&
                    request.auth.uid in resource.data.collaboratorIds &&
                    request.auth.uid in resource.data.collaborators.keys() &&
                    resource.data.collaborators[request.auth.uid].role == 'owner';

      allow delete: if isOwner(campaignId);
    }

    // Proposal documents (1-per-campaign) - TEMPORARILY PERMISSIVE
    match /campaigns/{campaignId}/proposal/{proposalId} {
      allow read, write, create: if true;
    }

    // User profile documents - TEMPORARILY PERMISSIVE
    match /users/{userId} {
      allow read, write, create: if true;
    }

    // Real-time presence documents - TEMPORARILY PERMISSIVE
    match /presence/{campaignId}/users/{userId} {
      allow read, write, create: if true;
    }

    // Campaign activity logs - TEMPORARILY PERMISSIVE
    match /activity/{campaignId}/logs/{logId} {
      allow read, write, create: if true;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}